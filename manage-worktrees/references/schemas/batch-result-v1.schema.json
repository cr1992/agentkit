{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.example/schemas/batch-result-v1.schema.json",
  "title": "Batch Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "candidate_sha",
    "fingerprint",
    "target_ref",
    "target_sha",
    "ordered_input_shas",
    "evidence_manifest_digest",
    "evidence_manifest",
    "reason",
    "result_digest",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "outcome": { "enum": ["passed", "failed", "stale"] },
    "candidate_sha": { "$ref": "#/$defs/objectId" },
    "fingerprint": { "$ref": "#/$defs/digest" },
    "target_ref": { "type": "string", "minLength": 1 },
    "target_sha": { "$ref": "#/$defs/objectId" },
    "ordered_input_shas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/objectId" }
    },
    "evidence_manifest_digest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "evidence_manifest": {
      "oneOf": [{ "$ref": "#/$defs/evidenceManifest" }, { "type": "null" }]
    },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
    "result_digest": { "$ref": "#/$defs/digest" },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["passed", "failed"] } } },
      "then": {
        "properties": {
          "evidence_manifest_digest": { "$ref": "#/$defs/digest" },
          "evidence_manifest": {
            "allOf": [
              { "$ref": "#/$defs/evidenceManifest" },
              {
                "properties": {
                  "contract_digest": { "$ref": "#/$defs/digest" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "const": "stale" } } },
      "then": { "properties": { "reason": { "type": "string", "minLength": 1 } } }
    }
  ],
  "$defs": {
    "objectId": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "evidenceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "contract_digest", "checks"],
      "properties": {
        "schema_version": { "const": 1 },
        "contract_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment", "argv", "outcome", "exit_code", "evidence_refs"],
      "properties": {
        "name": { "$ref": "#/$defs/text120" },
        "environment": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "allOf": [
              { "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
              { "not": { "pattern": "(?:secret|token|password|credential|private[_-]?key|api[_-]?key)" } }
            ]
          },
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "maxLength": 500, "pattern": "^[^\\u0000\\r\\n]*$" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/text1000NoNewline" }
        },
        "outcome": { "enum": ["passed", "failed", "undecidable"] },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "digest"],
            "properties": {
              "kind": { "$ref": "#/$defs/text40" },
              "id": { "$ref": "#/$defs/text1000" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "text40": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "text120": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "text1000": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "text1000NoNewline": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000\\r\\n]+$" }
  }
}
