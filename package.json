{
  "name": "@cr1992/agentkit",
  "version": "1.6.1",
  "description": "Agent engineering toolkit: orchestration, git worktree isolation, independent verification and bounded verify loops.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cr1992/agentkit.git"
  },
  "homepage": "https://github.com/cr1992/agentkit#readme",
  "bugs": {
    "url": "https://github.com/cr1992/agentkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "agentkit": "bin/agentkit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tools/validate-skills.mjs",
    "test": "node tools/validate-skills.mjs && node --test tests/*.test.mjs domains/*/*.test.mjs scripts/*.test.mjs evals/*/tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.mjs\" --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"evals/**\" --test-coverage-exclude=\"examples/**\" --test-coverage-exclude=\"scripts/**\" --test-coverage-lines=91 --test-coverage-branches=67 --test-coverage-functions=96 tests/*.test.mjs domains/*/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "files": [
    "CHANGELOG.md",
    "shell-manifest.json",
    "bin/",
    "domains/",
    "!domains/**/*.test.mjs",
    "core/",
    "schemas/",
    "docs/worktree/",
    "docs/verify/",
    "docs/orchestrate/",
    "docs/loop/",
    "orchestrate-subagents/",
    "manage-worktrees/",
    "verify-agent-output/",
    "run-agent-verify-loop/",
    "examples/"
  ],
  "dependencies": {}
}
